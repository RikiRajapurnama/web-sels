APP_NAME="XL SATU WiFi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ucok-six.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------------------------------
# Vercel (serverless) runtime — safe defaults.
# These values are also applied automatically by api/index.php when they
# are not set in the Vercel dashboard, so the customer website NEVER 500s
# just because a database is not configured yet.
# ------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------
# Database — PRODUCTION (Vercel).
#
# Do NOT point this at your local XAMPP database (127.0.0.1) and do NOT
# rely on the local SQLite file: the Vercel serverless filesystem is
# read-only, so a local database can never be used in production.
#
# Create a free ONLINE database (MySQL recommended, e.g. Aiven / Railway /
# hosting panel; PostgreSQL also supported, e.g. Neon / Supabase) and paste
# its values as Environment Variables on the Vercel dashboard. The customer
# website keeps working while no database is set; the Admin Sales panel only
# goes online once these variables are configured.
#
# On first deploy set APP_SEED=true so migrations + seeders run (this
# creates the admin user from ADMIN_* below and the default content), then
# set it back to false.
#
# MySQL:
#   DB_CONNECTION=mysql
#   DB_HOST=<host online, NOT 127.0.0.1>
#   DB_PORT=3306
#   DB_DATABASE=<nama database online>
#   DB_USERNAME=<user database online>
#   DB_PASSWORD=<password database online>
#   DB_SSL=true          # jika provider butuh TLS (Aiven, Railway, dll.)
#   DB_SSL_VERIFY=false  # tetap true jika certificate ber-valid
#
# PostgreSQL alternative:
#   DB_CONNECTION=pgsql
#   DB_HOST=<host online>
#   DB_PORT=5432
#   DB_DATABASE=
#   DB_USERNAME=
#   DB_PASSWORD=
#   DB_SSLMODE=require
# ------------------------------------------------------------------
DB_CONNECTION=sqlite

APP_SEED=false

# ------------------------------------------------------------------
# Admin Sales credentials — used by APP_SEED to create the admin user.
# The password is stored with Hash::make(). On Vercel set these as
# Environment Variables so the seeder creates the same account.
# ------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminXL2026!
ADMIN_EMAIL=admin@xlsatuwifi.com
ADMIN_NAME="Riki Raja Purnama"

# ------------------------------------------------------------------
# Encryption key — REQUIRED for admin login to persist sessions across
# serverless requests (login + forms + CSRF). Generate locally with:
#   php artisan key:generate --show
# then paste the value as the APP_KEY environment variable on Vercel.
# The key is intentionally NOT committed to vercel.json/GitHub; only the
# Vercel dashboard holds it. If APP_KEY is missing, api/index.php generates
# a per-request fallback so pages still load (but sessions will NOT survive
# between requests, so login will not work until APP_KEY is set).
# ------------------------------------------------------------------
# APP_KEY=base64:PASTE_YOUR_GENERATED_KEY_HERE

# Optional runtime cache paths (api/index.php sets these automatically):
# APP_CONFIG_CACHE=/tmp/config.php
# APP_EVENTS_CACHE=/tmp/events.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_ROUTES_CACHE=/tmp/routes.php
# APP_SERVICES_CACHE=/tmp/services.php
# VIEW_COMPILED_PATH=/tmp

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
