APP_NAME="XL SATU WiFi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ucok-six.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------------------------------
# Vercel (serverless) runtime — safe defaults.
# These values are also applied automatically by api/index.php when they
# are not set in the Vercel dashboard, so the customer website NEVER 500s
# just because a database is not configured yet.
# ------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------
# Database — set these on Vercel using Environment Variables.
#
# The website works WITHOUT a database: the customer page falls back to
# default content and the admin login page stays reachable. Configure a
# database (e.g. a free MySQL/PostgreSQL cloud provider) if you want the
# Admin Sales panel to save promo, paket, harga, area layanan, nomor
# WhatsApp dan informasi sales.
#
# On first deploy set APP_SEED=true so migrations + seeders run (creates
# the admin user from ADMIN_* below and the default content), then set it
# back to false.
# ------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# PostgreSQL alternative:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

APP_SEED=false

# ------------------------------------------------------------------
# Admin Sales credentials — used by APP_SEED to create the admin user.
# ------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@xlsatuwifi.test
ADMIN_NAME="Riki Raja Purnama"

# ------------------------------------------------------------------
# Encryption key — REQUIRED for sessions to persist across serverless
# requests (login + forms + CSRF). Generate locally with:
#   php artisan key:generate --show
# then paste the value as the APP_KEY environment variable on Vercel.
# A working APP_KEY is also shipped in vercel.json (env block) so the
# first deploy works out of the box; you can move it to the Vercel
# dashboard "Environment Variables" if you prefer to keep secrets there.
# If APP_KEY is missing entirely, api/index.php generates a per-request
# fallback so pages still load (but sessions will not survive between
# requests).
# ------------------------------------------------------------------
# APP_KEY=base64:PASTE_YOUR_GENERATED_KEY_HERE

# Optional runtime cache paths (api/index.php sets these automatically):
# APP_CONFIG_CACHE=/tmp/config.php
# APP_EVENTS_CACHE=/tmp/events.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_ROUTES_CACHE=/tmp/routes.php
# APP_SERVICES_CACHE=/tmp/services.php
# VIEW_COMPILED_PATH=/tmp

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
